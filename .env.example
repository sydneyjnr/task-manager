# Copy this file to .env and fill in your own MySQL password.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/task_manager"

# Auth.js (Google sign-in)
# AUTH_SECRET: a random secret that protects the sign-in cookies.
#   Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
